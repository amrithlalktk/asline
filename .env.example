# Copy to .env for local development, or add each of these in
# Vercel → Project → Settings → Environment Variables.

# PostgreSQL. On Vercel + Neon: DATABASE_URL = the pooled URL,
# DIRECT_URL = the unpooled/direct URL. On Vercel it's optional — taken
# from Neon's DATABASE_URL_UNPOOLED when not set.
DATABASE_URL="postgresql://user:password@host:5432/asline?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/asline?sslmode=require"

# Long random string that signs login sessions — e.g. `openssl rand -hex 32`.
SESSION_SECRET=""

# Currency shown in the app (baked in at build time).
NEXT_PUBLIC_CURRENCY="INR"

# "true" when served over HTTPS (always on Vercel).
COOKIE_SECURE="true"

# Public address of the app — used in password-setup/reset email links.
APP_URL="https://your-app.vercel.app"

# Optional: SMTP for invite/reset/PDF emails. Without it, emails are only
# written to the server log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Scheduled DB backups (Vercel Cron → GitHub Actions "Database backup").
# CRON_SECRET: any long random string. GITHUB_BACKUP_TOKEN: fine-grained
# GitHub token for this repo with "Actions: Read and write".
CRON_SECRET=""
GITHUB_BACKUP_TOKEN=""
